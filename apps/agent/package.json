    "@hono/zod-openapi": "^1.2.0",
    "@tigrisdata/storage": "^2.10.2",
    "@weldr/db": "workspace:*",
    "@weldr/shared": "workspace:*",
    "ai": "^6.0.31",
    "better-auth": "^1.3.34",
    "fast-xml-parser": "^5.2.5",
    "handlebars": "^4.7.8",
    "hono": "^4.11.3",
    "hono-pino": "^0.10.3",
    "openai": "^5.5.1",
    "pluralize": "^8.0.0",
    "redis": "^5.5.5",
    "simple-git": "^3.28.0",
    "xstate": "^5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/node": "^22.15.30",
    "@types/pluralize": "^0.0.33",
    "dotenv-cli": "^7.4.4",
    "tsdown": "^0.12.9",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  }
