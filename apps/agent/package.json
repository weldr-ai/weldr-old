{
  "name": "@weldr/agent",
  "type": "module",
  "scripts": {
    "dev": "bun with-env tsx watch --clear-screen=false src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "clean": "git clean -xdf .turbo node_modules dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.12",
    "@ai-sdk/google": "^3.0.7",
    "@ai-sdk/openai": "^3.0.9",
