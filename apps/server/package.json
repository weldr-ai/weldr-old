{
  "name": "@weldr/server",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf build node_modules dist .turbo .tsbuildinfo",
    "db:generate": "bun with-env bun run drizzle-kit generate",
    "db:migrate": "bun with-env bun run drizzle-kit migrate",
    "db:pull": "bun with-env bun run drizzle-kit pull",
    "db:push": "bun with-env bun run drizzle-kit push",
    "db:studio": "bun with-env bun run drizzle-kit studio",
    "dev": "bun --watch src/server.ts",
    "start": "bun --import ./dist/instrument.server.mjs ./dist/server.mjs",
    "typecheck": "tsc --build",
    "with-env": "dotenv -e .env.local --"
  },
  "dependencies": {
    "@axiomhq/pino": "^1.3.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@orpc/client": "^1.12.3",
    "@orpc/experimental-pino": "^1.12.3",
    "@orpc/openapi": "^1.12.3",
    "@orpc/otel": "^1.12.3",
    "@orpc/server": "^1.12.3",
    "@orpc/zod": "^1.12.3",
    "@sentry/bun": "^10.30.0",
    "@weldr/api_v2": "workspace:*",
    "@weldr/auth": "workspace:*",
    "@weldr/db": "workspace:*",
    "@weldr/shared": "workspace:*",
    "better-auth": "^1.4.7",
    "drizzle": "^1.4.0",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^19.2.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@weldr/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.19.0-beta.1",
    "typescript": "^5.9.3"
  }
}
