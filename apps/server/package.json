{
  "name": "@weldr/server",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf build node_modules dist .turbo .tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --watch src/server.ts",
    "start": "bun --import ./dist/instrument.server.mjs ./dist/server.mjs",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@axiomhq/pino": "^1.3.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@orpc/otel": "^1.13.4",
    "@sentry/bun": "^10.30.0",
    "@weldr/api": "workspace:*",
    "pino": "^10.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@weldr/tsconfig": "workspace:*",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.19.0-beta.1",
    "typescript": "^5.9.3"
  }
}
