{
  "name": "@weldr/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./utils": "./src/utils.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules dist .tsbuildinfo",
    "check": "drizzle-kit check",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:drop": "drizzle-kit drop",
    "pull": "drizzle-kit introspect",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "up": "drizzle-kit up",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@weldr/shared": "workspace:*",
    "drizzle": "^1.4.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@weldr/tsconfig": "workspace:*",
    "ai": "6.0.39",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
